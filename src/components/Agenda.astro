---
import { dictionaries, type Lang } from '../i18n';
import { CALENDAR_WEBCAL, ORG_URL } from '../data/links';
import { getAgenda, place, stub, when } from '../lib/agenda';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const t = dictionaries[Astro.props.lang];
const locale = t.date.locale;
const agenda = await getAgenda();
const events = agenda.events.slice(0, 6);
---

<section id="agenda" class="section band">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>{t.agenda.title}</h2>
        <p>{t.agenda.lead}</p>
      </div>
      <div class="head-actions">
        <a class="btn btn-secondary" href={CALENDAR_WEBCAL}><Icon name="calendar" />{t.agenda.subscribe}</a>
        <a class="link-arrow" href={ORG_URL} target="_blank" rel="noopener">{t.agenda.all} →</a>
      </div>
    </div>

    {
      events.length > 0 ? (
        <ul class="tickets">
          {events.map((event) => {
            const { day, month } = stub(event.start, locale);
            const Tag = event.url ? 'a' : 'div';
            return (
              <li>
                <Tag
                  class:list={['ticket', { canceled: event.canceled }]}
                  href={event.url ?? undefined}
                  target={event.url ? '_blank' : undefined}
                  rel={event.url ? 'noopener' : undefined}
                >
                  <div class="stub" aria-hidden="true">
                    <span class="day">{day}</span>
                    <span class="month">{month}</span>
                  </div>
                  <div class="body">
                    <h3>{event.name}</h3>
                    <p class="when">
                      <time datetime={event.start.toISOString()}>{when(event, locale)}</time>
                    </p>
                    {event.location && (
                      <p class="where" title={event.location}>
                        <Icon name="pin" size={16} />
                        {place(event.location)}
                      </p>
                    )}
                    {event.canceled && <span class="tag">{t.agenda.canceled}</span>}
                  </div>
                </Tag>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="empty">
          {agenda.ok ? t.agenda.empty : t.agenda.unavailable}{' '}
          <a href={ORG_URL} target="_blank" rel="noopener">
            {t.agenda.all}
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .band {
    background: var(--primary-subtle);
  }

  .head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .tickets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--space-4);
  }

  /* A ticket: the date on a stub, a perforated edge, the event on the rest. */
  .ticket {
    display: flex;
    height: 100%;
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raised);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s, transform 0.15s;
  }

  a.ticket:hover {
    box-shadow: var(--shadow-raised-hover);
    transform: translateY(-2px);
  }

  a.ticket:hover h3 {
    color: var(--brand-deep);
  }

  .stub {
    flex: none;
    width: 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-2);
    border-right: 2px dashed var(--rule);
    font-family: var(--font-heading);
    text-align: center;
  }

  .day {
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
  }

  .month {
    margin-top: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand-deep);
  }

  .body {
    padding: var(--space-4) var(--space-5);
    min-width: 0;
  }

  h3 {
    font-size: 1.1rem;
  }

  .when,
  .where {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .where {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-1);
  }

  .where :global(svg) {
    flex: none;
  }

  .canceled h3 {
    text-decoration: line-through;
  }

  .tag {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 2px 8px;
    border-radius: var(--radius-label);
    background: var(--coral);
    color: var(--on-pop);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .empty {
    padding: var(--space-5);
    background: var(--surface);
    border-radius: var(--radius-card);
    color: var(--muted);
  }
</style>
