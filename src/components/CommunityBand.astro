---
import { dictionaries, type Lang } from '../i18n';
import { COMMUNITY, ORG_URL } from '../data/links';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const t = dictionaries[Astro.props.lang];
const links = [
  ['games', `${COMMUNITY}/games`],
  ['studios', `${COMMUNITY}/studios`],
  ['events', `${COMMUNITY}/events`],
  ['atlas', `${COMMUNITY}/places`],
  ['org', ORG_URL],
] as const;
---

<section id="community" class="section">
  <div class="wrap">
    <div class="panel">
      <div class="copy">
        <p class="kicker">{t.community.kicker}</p>
        <h2>{t.community.title}</h2>
        <p class="lead">{t.community.lead}</p>
        <a class="btn btn-cta" href={COMMUNITY} target="_blank" rel="noopener">{t.community.cta}<Icon name="arrow" /></a>
      </div>
      <ul class="links">
        {
          links.map(([key, href]) => (
            <li>
              <a href={href} target="_blank" rel="noopener">
                {t.community.links[key]}
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Always the dark Community green, in both themes: the page's one loud block. */
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
    padding: var(--space-7);
    border-radius: var(--radius-panel);
    background: #054f45;
    color: #e8f1ee;
    box-shadow: var(--shadow-lift);
  }

  .kicker {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--season-spring);
  }

  h2 {
    margin-top: var(--space-3);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    color: #ffffff;
  }

  .lead {
    margin-top: var(--space-4);
    color: #b9d9d1;
    max-width: 52ch;
  }

  .btn-cta {
    margin-top: var(--space-6);
    background: var(--night-ink);
    color: var(--night);
  }

  .btn-cta:hover {
    background: #ffffff;
    color: var(--night);
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links li + li {
    border-top: 1px solid rgba(232, 241, 238, 0.16);
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 4px;
    color: #ffffff;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .links a :global(svg) {
    transition: transform 160ms var(--ease);
    color: #2cc4ac;
  }

  .links a:hover :global(svg) {
    transform: translateX(4px);
  }

  .links a:hover {
    color: #8fe3d4;
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
