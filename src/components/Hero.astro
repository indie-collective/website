---
// Night at the festival: the Stunfest Indie zone fills the hero, the headline
// sits on its darkened left side, and the next event's ticket rises from the
// bottom edge into the agenda.
import { Image } from 'astro:assets';
import { dictionaries, type Lang } from '../i18n';
import { DISCORD } from '../data/links';
import { getAgenda } from '../lib/agenda';
import { asset } from '../lib/images';
import Icon from './Icon.astro';
import Ticket from './Ticket.astro';

interface Props {
  lang: Lang;
}
const t = dictionaries[Astro.props.lang];
const next = (await getAgenda()).events[0];
---

<section class:list={['hero', { 'with-ticket': next }]}>
  <div class="scene">
    <Image
      class="photo"
      src={asset('portfolio/stunfest-indie-full.jpg')}
      alt={t.hero.photo}
      width={2400}
      widths={[900, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap content">
      <p class="kicker">{t.hero.kicker}</p>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="actions">
        <a class="btn btn-light" href="#adherer">{t.hero.join}<Icon name="arrow" /></a>
        <a class="btn btn-ghost" href={DISCORD} target="_blank" rel="noopener"><Icon name="discord" />{t.hero.discord}</a>
      </div>
    </div>
    <p class="sticker">Stunfest · Zone Indie</p>
    <p class="wrap credit">{t.hero.credit}</p>
  </div>

  {
    next && (
      <div class="wrap rise">
        <div class="ticket-slot">
          <Ticket event={next} locale={t.date.locale} canceledLabel={t.agenda.canceled} eyebrow={t.hero.next} big />
        </div>
      </div>
    )
  }
</section>

<style>
  .hero {
    --ticket-notch-top: var(--night);
    --ticket-notch-bottom: var(--primary-subtle);
    position: relative;
    /* Under the ticket's lower half: the agenda's colour, which follows. */
    background: var(--primary-subtle);
  }

  .scene {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(760px, calc(100svh - 64px));
    padding-block: var(--space-9) calc(var(--space-9) + var(--space-6));
    background: var(--night);
    color: var(--night-ink);
    overflow: hidden;
  }

  .scene :global(.photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }

  /* Dark on the left for the headline, the photo's light on the right. */
  .scene::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(8 16 14 / 0.92) 0%, rgb(8 16 14 / 0.78) 38%, rgb(8 16 14 / 0.2) 72%, rgb(8 16 14 / 0.1) 100%),
      linear-gradient(0deg, rgb(8 16 14 / 0.7) 0%, transparent 35%);
  }

  .content {
    position: relative;
  }

  .kicker {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--season-spring);
  }

  h1 {
    max-width: 12ch;
    margin-top: var(--space-4);
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .lead {
    max-width: 36rem;
    margin-top: var(--space-5);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--night-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .btn-light {
    min-height: 48px;
    background: var(--night-ink);
    color: var(--night);
  }

  .btn-light:hover {
    background: #ffffff;
    color: var(--night);
  }

  .btn-ghost {
    min-height: 48px;
    background: rgb(243 246 242 / 0.12);
    color: var(--night-ink);
    box-shadow: inset 0 0 0 1px rgb(243 246 242 / 0.2);
  }

  .btn-ghost:hover {
    background: rgb(243 246 242 / 0.2);
    color: #ffffff;
  }

  .sticker {
    position: absolute;
    right: var(--gutter);
    top: var(--space-6);
    transform: rotate(3deg);
    padding: 8px 14px;
    border-radius: var(--radius-control);
    background: var(--sun);
    color: var(--on-pop);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: var(--shadow-lift);
  }

  /* The photographer, small, on the photo's bottom-left corner. */
  .credit {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-4);
    font-size: 0.75rem;
    color: rgb(243 246 242 / 0.6);
  }

  /* The next ticket straddles the hero's bottom edge. */
  .rise {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * var(--space-9));
    display: flex;
    justify-content: flex-end;
  }

  .ticket-slot {
    width: min(100%, 520px);
    box-shadow: var(--shadow-lift);
    border-radius: var(--radius-card);
  }

  @media (max-width: 760px) {
    .scene {
      align-items: flex-end;
      min-height: 0;
      padding-block: calc(var(--space-9) * 2 + var(--space-7)) calc(var(--space-9) + var(--space-5));
    }
    .scene::before {
      background: linear-gradient(0deg, rgb(8 16 14 / 0.95) 0%, rgb(8 16 14 / 0.85) 50%, rgb(8 16 14 / 0.15) 85%, rgb(8 16 14 / 0.05) 100%);
    }
    .sticker {
      top: var(--space-5);
    }
    /* The ticket covers the bottom edge on phones: the credit goes under the sticker. */
    .credit {
      top: calc(var(--space-5) + var(--space-7));
      bottom: auto;
      text-align: right;
    }
    .lead {
      font-size: 1.05rem;
    }
  }
</style>
