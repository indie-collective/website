---
import { dictionaries, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const t = dictionaries[Astro.props.lang];
const items = [
  { key: 'stunfest', href: '#stunfest' },
  { key: 'jams', href: '#jams' },
  { key: 'podcast', href: '#podcast' },
  { key: 'community', href: '#community' },
] as const;
---

<section id="association" class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>{t.missions.title}</h2>
        <p>{t.missions.lead}</p>
      </div>
    </div>
    <ul class="missions">
      {
        items.map(({ key, href }) => (
          <li>
            <a href={href}>
              <h3>
                {t.missions.items[key].title}
                <span aria-hidden="true">→</span>
              </h3>
              <p>{t.missions.items[key].text}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .missions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }

  .missions li + li {
    border-left: 1px solid var(--rule);
  }

  .missions a {
    display: block;
    height: 100%;
    padding: var(--space-5) var(--space-5) var(--space-2);
    color: inherit;
    text-decoration: none;
  }

  .missions li:first-child a {
    padding-left: 0;
  }

  h3 {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: 1.35rem;
    transition: color 160ms var(--ease);
  }

  h3 span {
    color: var(--brand);
    transition: transform 160ms var(--ease);
  }

  a:hover h3 {
    color: var(--brand-deep);
  }

  a:hover h3 span {
    transform: translateX(3px);
  }

  p {
    margin-top: var(--space-2);
    color: var(--muted);
    max-width: 34ch;
  }

  @media (max-width: 1000px) {
    .missions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .missions li:nth-child(3) {
      border-left: 0;
    }
    .missions li:nth-child(odd) a {
      padding-left: 0;
    }
    .missions li:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 760px) {
    .missions {
      grid-template-columns: 1fr;
    }
    .missions li + li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .missions a,
    .missions li:first-child a {
      padding: var(--space-4) 0;
    }
  }
</style>
