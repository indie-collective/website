---
// A project's full story in a modal: photo, text, links, and its editions on
// Community. Opened by any button with data-open="dialog-<id>".
import { Image } from 'astro:assets';
import { pick, type Lang } from '../i18n';
import { eventUrl, type Project } from '../data/jams';
import { asset } from '../lib/images';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  lang: Lang;
  closeLabel: string;
  editionsLabel: string;
}
const { project, lang, closeLabel, editionsLabel } = Astro.props;
const body = project.body[lang] ? { paragraphs: project.body[lang]!, lang } : { paragraphs: project.body.fr, lang: 'fr' };
const role = pick(project.role, lang);
---

<dialog id={`dialog-${project.id}`} class="dialog" aria-labelledby={`dialog-${project.id}-title`}>
  <div class="sheet">
    <form method="dialog" class="close">
      <button type="submit" aria-label={closeLabel}>
        <Icon name="close" />
      </button>
    </form>
    <Image
      class="photo"
      src={asset(project.photo)}
      alt=""
      width={1000}
      widths={[640, 1000]}
      sizes="(max-width: 720px) 100vw, 720px"
      loading="lazy"
    />
    <div class="content">
      <p class="role" lang={role.lang}>{role.text}</p>
      <h3 id={`dialog-${project.id}-title`}>{project.name}</h3>
      <div class="prose" lang={body.lang}>
        {body.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
      </div>

      {
        project.links && (
          <div class="links">
            {project.links.map((link) => {
              const label = pick(link.label, lang);
              return (
                <a class="btn btn-secondary" href={link.href} target="_blank" rel="noopener" lang={label.lang}>
                  {label.text}
                </a>
              );
            })}
          </div>
        )
      }

      {
        project.editions && (
          <div class="editions">
            <h4>{editionsLabel}</h4>
            <ul>
              {project.editions.map((edition) => (
                <li>
                  <a href={eventUrl(edition.slug)} target="_blank" rel="noopener">
                    {edition.year}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((button) => {
    if (button.dataset.bound) return;
    button.dataset.bound = 'true';
    const dialog = document.getElementById(button.dataset.open!) as HTMLDialogElement | null;
    button.addEventListener('click', () => dialog?.showModal());
  });
  // A click on the backdrop closes the dialog.
  document.querySelectorAll<HTMLDialogElement>('dialog.dialog').forEach((dialog) =>
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    })
  );
</script>

<style>
  .dialog {
    width: min(720px, calc(100vw - 24px));
    max-height: calc(100dvh - 48px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-panel);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-lift);
  }

  .dialog::backdrop {
    background: rgba(13, 23, 21, 0.55);
    backdrop-filter: blur(2px);
  }

  .sheet {
    position: relative;
  }

  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
  }

  .close button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-lift);
    cursor: pointer;
  }

  .sheet :global(.photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .content {
    padding: var(--space-5) var(--space-6) var(--space-6);
  }

  .role {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .content h3 {
    font-size: 1.75rem;
    margin-top: var(--space-1);
  }

  .prose {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .editions {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 2px dashed var(--rule);
  }

  .editions h4 {
    font-size: 0.95rem;
  }

  .editions ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .editions a {
    display: block;
    padding: 4px 12px;
    border-radius: var(--radius-label);
    background: var(--primary-subtle);
    color: var(--brand-deep);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .editions a:hover {
    background: var(--primary-muted);
  }

  @media (max-width: 560px) {
    .content {
      padding: var(--space-5);
    }
  }
</style>
