---
import { Image } from 'astro:assets';
import { dictionaries, pick, type Lang } from '../i18n';
import { eventUrl, projects } from '../data/projects';
import { ORG_URL } from '../data/links';
import { asset } from '../lib/images';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionaries[lang];
const bodyOf = (body: (typeof projects)[number]['body']) =>
  body[lang] ? { paragraphs: body[lang]!, lang } : { paragraphs: body.fr, lang: 'fr' as const };
---

<section id="projets" class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>{t.projects.title}</h2>
        <p>{t.projects.lead}</p>
      </div>
      <a class="link-arrow" href={ORG_URL} target="_blank" rel="noopener">{t.projects.allJams} →</a>
    </div>

    <ul class="cards">
      {
        projects.map((project) => {
          const role = pick(project.role, lang);
          return (
            <li id={`project-${project.id}`}>
              <button class="card" type="button" data-open={`dialog-${project.id}`} aria-haspopup="dialog">
                <Image
                  src={asset(project.thumbnail)}
                  alt=""
                  width={720}
                  widths={[360, 540, 720]}
                  sizes="(max-width: 640px) 100vw, 360px"
                />
                <span class="caption">
                  <span class="name">{project.name}</span>
                  <span class="role" lang={role.lang}>
                    {role.text}
                  </span>
                </span>
                {project.editions && <span class="count">{t.projects.editionCount.replace('{n}', String(project.editions.length))}</span>}
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>

  {
    projects.map((project) => {
      const body = bodyOf(project.body);
      const role = pick(project.role, lang);
      return (
        <dialog id={`dialog-${project.id}`} class="dialog" aria-labelledby={`dialog-${project.id}-title`}>
          <div class="sheet">
            <form method="dialog" class="close">
              <button type="submit" aria-label={t.projects.close}>
                <Icon name="close" />
              </button>
            </form>
            <Image
              class="photo"
              src={asset(project.photo)}
              alt=""
              width={1000}
              widths={[640, 1000]}
              sizes="(max-width: 720px) 100vw, 720px"
              loading="lazy"
            />
            <div class="content">
              <p class="role" lang={role.lang}>
                {role.text}
              </p>
              <h3 id={`dialog-${project.id}-title`}>{project.name}</h3>
              <div class="prose" lang={body.lang}>
                {body.paragraphs.map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>

              {project.links && (
                <div class="links">
                  {project.links.map((link) => {
                    const label = pick(link.label, lang);
                    return (
                      <a class="btn btn-secondary" href={link.href} target="_blank" rel="noopener" lang={label.lang}>
                        {label.text}
                      </a>
                    );
                  })}
                </div>
              )}

              {project.editions && (
                <div class="editions">
                  <h4>{t.projects.editions}</h4>
                  <ul>
                    {project.editions.map((edition) => (
                      <li>
                        <a href={eventUrl(edition.slug)} target="_blank" rel="noopener">
                          {edition.year}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </dialog>
      );
    })
  }
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.open!) as HTMLDialogElement | null;
    button.addEventListener('click', () => dialog?.showModal());
  });
  // A click on the backdrop closes the dialog.
  document.querySelectorAll<HTMLDialogElement>('dialog.dialog').forEach((dialog) =>
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    })
  );
</script>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raised);
    overflow: hidden;
    text-align: start;
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: box-shadow 0.15s, transform 0.15s;
  }

  .card:hover {
    box-shadow: var(--shadow-raised-hover);
    transform: translateY(-2px);
  }

  .card :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
  }

  .card:hover .name {
    color: var(--brand-deep);
  }

  .role {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .count {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 2px 10px;
    border-radius: var(--radius-label);
    background: var(--sun);
    color: var(--on-pop);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .dialog {
    width: min(720px, calc(100vw - 24px));
    max-height: calc(100dvh - 48px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-panel);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-lift);
  }

  .dialog::backdrop {
    background: rgba(13, 23, 21, 0.55);
    backdrop-filter: blur(2px);
  }

  .sheet {
    position: relative;
  }

  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
  }

  .close button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-lift);
    cursor: pointer;
  }

  .sheet :global(.photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .content {
    padding: var(--space-5) var(--space-6) var(--space-6);
  }

  .content h3 {
    font-size: 1.75rem;
    margin-top: var(--space-1);
  }

  .prose {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .editions {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 2px dashed var(--rule);
  }

  .editions h4 {
    font-size: 0.95rem;
  }

  .editions ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .editions a {
    display: block;
    padding: 4px 12px;
    border-radius: var(--radius-label);
    background: var(--primary-subtle);
    color: var(--brand-deep);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .editions a:hover {
    background: var(--primary-muted);
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .content {
      padding: var(--space-5);
    }
  }
</style>
