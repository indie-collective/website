---
import { Image } from 'astro:assets';
import { dictionaries, pick, type Lang } from '../i18n';
import { team, type Member } from '../data/team';
import { asset } from '../lib/images';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionaries[lang];
const groups: Member['group'][] = ['bureau', 'ca', 'members'];
const linkName = { x: 'X', github: 'GitHub', bluesky: 'Bluesky' };
---

<section id="equipe" class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>{t.team.title}</h2>
        <p>{t.team.lead}</p>
      </div>
    </div>

    {
      groups.map((group) => (
        <div class="group">
          <h3>{t.team.groups[group]}</h3>
          <ul class="people">
            {team
              .filter((member) => member.group === group)
              .map((member) => {
                const tagline = pick(member.tagline, lang);
                const name = `${member.first} ${member.last}`;
                return (
                  <li class="person">
                    <Image src={asset(member.photo)} alt={`${t.team.photoOf} ${name}`} width={160} height={160} />
                    <div>
                      <p class="name">{name}</p>
                      <p class="tagline" lang={tagline.lang}>
                        {tagline.text}
                      </p>
                      {member.links && (
                        <ul class="socials">
                          {member.links.map((link) => (
                            <li>
                              <a href={link.href} target="_blank" rel="noopener">
                                <Icon name={link.kind} size={16} label={`${linkName[link.kind]} · ${name}`} />
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </li>
                );
              })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .group + .group {
    margin-top: var(--space-6);
  }

  .group h3 {
    font-size: 1rem;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .person {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raised);
  }

  .person :global(img) {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
  }

  .name {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.3;
  }

  .tagline {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .socials {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    gap: var(--space-1);
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--muted);
  }

  .socials a:hover {
    background: var(--primary-subtle);
    color: var(--brand-deep);
  }

  @media (max-width: 900px) {
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .people {
      grid-template-columns: 1fr;
    }
  }
</style>
